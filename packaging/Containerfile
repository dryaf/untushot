FROM docker.io/library/ubuntu@sha256:076e7bf82319619f28dd0aa9c02ab34b055ad37100395b4f49a2ffba04fb5e11
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential pkg-config libgtk-3-dev libgtk-3-bin librsvg2-dev \
    libgirepository1.0-dev libayatana-appindicator3-dev libfuse2 \
    ca-certificates curl file patchelf squashfs-tools desktop-file-utils \
    python3 gettext locales git dpkg-dev \
    && locale-gen en_US.UTF-8 && rm -rf /var/lib/apt/lists/*
ENV PATH="/opt/rust/bin:${PATH}" LANG=en_US.UTF-8
WORKDIR /workspace
# Headless GTK checks still need a real font; the AppImage theme hook uses dbus-send.
RUN apt-get update && apt-get install -y --no-install-recommends fonts-dejavu-core dbus \
    && rm -rf /var/lib/apt/lists/*
